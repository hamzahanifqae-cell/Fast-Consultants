# iOS Simulator on the same Mac (current setup):
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Physical iPhone/Android on the same Wi‑Fi — use your Mac IP instead:
# 1. Run: ipconfig getifaddr en0
# 2. Start backend: php artisan serve --host=0.0.0.0 --port=8000
