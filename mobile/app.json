{
  "expo": {
    "name": "Fast Consultants",
    "slug": "education-consultant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "educationconsultant",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.fastconsultants.app",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is required for in-app interview video calls.",
        "NSMicrophoneUsageDescription": "Microphone access is required for in-app interview video calls.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.fastconsultants.app",
      "adaptiveIcon": {
        "backgroundColor": "#F24E68",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F24E68",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39de5643-0d0b-4fb6-8e13-63802bb8e5d9"
      }
    },
    "owner": "abubakar-lodhi"
  }
}
